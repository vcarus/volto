# Rust
/target

# The Pages site .github/workflows/docs.yml assembles: the mdBook manual at
# the root and the rustdoc laid out under api/. Running those steps by hand
# leaves it in the working tree.
/site/

# cargo-fuzz build tree and run outputs (fuzz/ is its own workspace, so the
# /target entry above does not cover it; the corpus is machine-local on purpose)
/fuzz/target/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/coverage/

# cargo-mutants run tree, left behind by a mutation run (src/main.rs stopped
# being excluded when it_cli.rs began running the binary, so a run touches it now)
/mutants.out/
/mutants.out.old/

# macOS
.DS_Store

# Project doc policy: public documentation (README.md, docs/) lives in the
# repository and is tracked; development notes live in dev_docs/ and are NOT
# tracked; CLAUDE.md is NOT tracked.
CLAUDE.md
/dev_docs/

# Local debugging artifacts
*.qlog
*.sslkeylog

# proptest failure-seed files; a persisted seed is for the debugging session
# that produced it, and a regression worth keeping becomes a named test case
proptest-regressions/
*.proptest-regressions

# Scratch files the interop job writes into the workspace (certificate, key,
# config, server log), in case the same steps are run by hand.
/interop-*

# Python bytecode from the interop and diff-oracle helpers
__pycache__/

# Claude Code local settings and subagent worktrees
/.claude/
