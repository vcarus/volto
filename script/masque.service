# systemd unit for volto, a MASQUE proxy server.
#
# Install: script/install-selfsigned.sh does all of this, plus a certificate and a
# generated credential. The steps below are for an operator who would rather not
# run it, or who already has a certificate.
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin volto
#   sudo install -m 0755 target/release/volto /usr/local/bin/volto
#   sudo install -d -o volto -g volto -m 0750 /etc/volto
#   sudo install -o volto -g volto -m 0640 script/config.example.toml /etc/volto/config.toml
#   sudo install -m 0644 script/masque.service /etc/systemd/system/volto.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable volto
#
# Enable without --now on purpose: the service is not started yet. Edit
# /etc/volto/config.toml first, setting the cert/key paths and [auth].users. The
# password the example ships is a placeholder published in this repository and in
# every release tarball, so a server started before that edit accepts a
# credential anybody can read. Start it once the edit is made:
#   sudo systemctl start volto
#
# Reload after a certificate renewal or a credential change (never drops
# established tunnels; a broken config file is rejected and the running one kept):
#   sudo systemctl reload volto

[Unit]
Description=volto MASQUE proxy (HTTP/3 CONNECT + CONNECT-UDP)
Documentation=https://github.com/vcarus/volto
# The network must be up: the listener binds a specific address.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/volto --config /etc/volto/config.toml

# SIGHUP re-reads the config file: new credentials and destination policy for new
# connections, and a renewed certificate for the endpoint. Existing connections
# keep the configuration they were accepted with.
ExecReload=/bin/kill -HUP $MAINPID

# SIGTERM starts the graceful shutdown: no new connections, GOAWAY on the existing
# ones, then a wait for their tunnels to finish. The drain costs 2 *
# server.shutdown_grace + 2 * CLOSE_FLUSH_TIMEOUT + EXIT_SLACK, which is
# 2 * shutdown_grace + 3 seconds at the shipped constants: each connection gets
# one grace period to drain its tunnels and one more to flush its CLOSE. The
# default grace of 5 gives 13 seconds, so 45 covers it.
KillSignal=SIGTERM
TimeoutStopSec=45

Restart=on-failure
RestartSec=5s

# --- File descriptors -------------------------------------------------------
# Every tunnel costs one descriptor, and one client multiplexes many onto a single
# QUIC connection. What volto checks at startup is limits.max_connections times
# limits.max_targets_per_conn plus 64 descriptors of headroom, against RLIMIT_NOFILE;
# the shipped defaults need 65600, so this leaves room for them. Raise either limit
# past this and raise LimitNOFILE with a drop-in too, or expect the startup warning.
LimitNOFILE=131072

# --- Privileges -------------------------------------------------------------
# Runs unprivileged. Binding 443 needs a capability rather than root: this grants
# exactly that one and nothing else.
#
# A fixed system user rather than DynamicUser=yes on purpose: the private key must
# be readable by this service and by nothing else, which needs a stable owner to
# grant it to (chown volto:volto, mode 0640). DynamicUser would force the key to be
# world-readable instead.
User=volto
Group=volto
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# --- Filesystem -------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# Read-only access to the config and the certificates. ProtectSystem=strict makes
# the rest of the filesystem read-only, so this is the only path that matters.
#
# Have certbot's deploy hook copy the renewed files into /etc/volto (owner volto,
# key mode 0640) and then `systemctl reload volto`, rather than pointing this at
# /etc/letsencrypt: the live symlinks there are root-only.
ReadOnlyPaths=/etc/volto

# --- Syscall and network surface -------------------------------------------
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# AF_INET and AF_INET6 are the families of the sockets volto opens itself with
# socket(2), including the bind that checks whether a target is one of this
# host's own addresses. The directive filters socket(2) only, so the AF_UNIX
# socketpair that tokio uses for signals is not affected. AF_UNIX and
# AF_NETLINK are for name resolution in a glibc build: getaddrinfo goes through
# NSS, modules such as `resolve` and `myhostname` open sockets in those
# families, and a denied family can fail the lookup. The static musl release
# binary has no NSS and does not need them. They stay allowed so that one unit
# serves both builds. volto does not read routes or list interfaces.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# --- Logging ----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
# volto writes plain lines to stdout; the level comes from the config file, and
# RUST_LOG overrides it without editing the config:
#   Environment=RUST_LOG=volto=debug,quinn=info
#
# When systemd hands stdout to the journal it also sets $JOURNAL_STREAM, which
# volto takes as the cue to prefix each line with a kernel-style "<N>" priority.
# journald strips that prefix and files the record with the real PRIORITY, so
# `journalctl -u volto -p warning` works. This needs no setting here:
# SyslogLevelPrefix= already defaults to true.

[Install]
WantedBy=multi-user.target
